# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# --- Supabase (owner's dev account) ------------------------------------------
# Both are safe in the browser; Row Level Security is the boundary (ADR-0004).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Public site (optional in dev) -----------------------------------------
# Canonical origin for <link rel=canonical> + sitemap. Set per environment on the
# host (staging = the *.vercel.app URL; production = the real domain).
VITE_SITE_ORIGIN=https://platinumpoint.co.ke
# Set to 1 on staging / not-yet-public deploys: forces noindex,nofollow site-wide
# and makes robots.txt Disallow everything. Unset (blank) for the public launch.
VITE_SITE_NOINDEX=
# Override the submission endpoint if needed (defaults to
# ${VITE_SUPABASE_URL}/functions/v1/submit).
VITE_SUBMIT_URL=

# --- Optional integrations (features degrade cleanly if absent) ------------
# Cloudflare Turnstile site key — adds the anti-spam widget to forms.
VITE_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics token — adds the cookieless analytics beacon.
VITE_CF_ANALYTICS_TOKEN=

# --- Edge Function secrets (NOT read by the frontend; set with
#     `npx supabase secrets set`). Listed here for reference only:
#   TURNSTILE_SECRET   RESEND_API_KEY   RESEND_FROM   NOTIFY_EMAIL   ALLOWED_ORIGIN
